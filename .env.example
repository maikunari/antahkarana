OPENROUTER_API_KEY=your_key_here
# Optional: the OpenRouter model Buddhi asks (default deepseek/deepseek-v4.1-flash)
ANTAHKARANA_BUDDHI_MODEL=
# Optional: turns on the Jev shadow judge (logged only; Buddhi still decides)
TYPESAFE_API_KEY=
ANTAHKARANA_DATA_DIR=./data
ANTAHKARANA_CONFIG_DIR=./config
# Optional: MCP transport. Empty or "stdio" (default): each client starts its own server,
# and only one can hold the vector store at a time. "http": one shared server on
# ANTAHKARANA_HOST:ANTAHKARANA_PORT (defaults 127.0.0.1:8799); see README "Running a shared server".
ANTAHKARANA_TRANSPORT=
ANTAHKARANA_HOST=
ANTAHKARANA_PORT=
